# Koneksi PostgreSQL (Neon, Supabase, Vercel Postgres, dll.)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/growth_os?sslmode=require"

# Rahasia untuk Auth.js. Buat dengan: openssl rand -base64 32
AUTH_SECRET=""

# URL publik aplikasi
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Opsional: izinkan pendaftaran akun baru (true/false)
ALLOW_SIGNUP="true"

# Penerimaan lead dari website personal brand (opsional; endpoint nonaktif bila kosong)
# Kunci minimal 32 karakter: openssl rand -hex 32
LEAD_INGEST_API_KEY=""
# Email akun Growth OS yang akan menerima prospek dari website
LEAD_INGEST_USER_EMAIL=""

# Cron notifikasi harian (Vercel Cron mengirim Authorization: Bearer <CRON_SECRET>). Minimal 32 karakter.
# Kosongkan untuk menonaktifkan endpoint /api/cron/notifications (notifikasi tetap dibuat saat halaman Notifikasi dibuka).
CRON_SECRET=""

# Opsional: rate limiter global lintas instance (Upstash Redis REST). Tanpa ini memakai in-memory per instance.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
