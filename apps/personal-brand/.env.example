# ── Situs ──
NEXT_PUBLIC_SITE_URL="http://localhost:3001"

# ── Kontak publik ──
# Nomor WhatsApp format internasional tanpa spasi/tanda baca, mis. 6281234567890
NEXT_PUBLIC_WHATSAPP_NUMBER=""
# Email yang ditampilkan ke pengunjung (opsional)
NEXT_PUBLIC_CONTACT_EMAIL=""

# ── Pengiriman form kontak (server-side, jangan diawali NEXT_PUBLIC_) ──
# Email penerima inquiry + API key Resend. Keduanya wajib agar email terkirim.
CONTACT_EMAIL=""
RESEND_API_KEY=""
# Alamat pengirim yang sudah diverifikasi di Resend, mis. "Website <halo@domainanda.com>"
CONTACT_FROM_EMAIL=""

# ── Integrasi Growth OS ──
# Tautan masuk admin (publik, hanya tautan)
NEXT_PUBLIC_GROWTH_OS_URL=""
# Pengiriman lead ke Growth OS (server-side). URL dasar tanpa garis miring akhir.
GROWTH_OS_API_URL=""
GROWTH_OS_API_KEY=""

# ── Analytics (opsional) ──
# Kosongkan untuk menonaktifkan. Memakai Plausible bila diisi.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""

# Opsional: rate limiter global lintas instance (Upstash Redis REST). Tanpa ini memakai in-memory per instance.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
